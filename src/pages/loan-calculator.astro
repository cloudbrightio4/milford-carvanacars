---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Loan Calculator" description="Estimate your monthly payment with our loan calculator.">
  <div class="container page narrow">
    <h1>Loan Calculator</h1>
    <p class="muted">Estimate your monthly payment.</p>
    <div class="calc">
      <div class="field"><label>Vehicle price ($)</label><input id="price" type="number" value="50000" /></div>
      <div class="field"><label>Down payment ($)</label><input id="down" type="number" value="10000" /></div>
      <div class="field"><label>Interest rate (% APR)</label><input id="rate" type="number" step="0.1" value="6.5" /></div>
      <div class="field"><label>Term (months)</label><select id="term"><option>36</option><option>48</option><option selected>60</option><option>72</option></select></div>
      <div class="result">
        <div>Estimated monthly payment</div>
        <div class="amount" id="monthly">$0</div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const el = (id) => document.getElementById(id);
  function calc() {
    const P = Number(el('price').value) - Number(el('down').value);
    const r = Number(el('rate').value) / 100 / 12;
    const n = Number(el('term').value);
    if (P <= 0 || r <= 0) { el('monthly').textContent = '$0'; return; }
    const m = P * r * Math.pow(1 + r, n) / (Math.pow(1 + r, n) - 1);
    el('monthly').textContent = '$' + Math.round(m).toLocaleString('en-US');
  }
  ['price', 'down', 'rate', 'term'].forEach((id) => el(id).addEventListener('input', calc));
  calc();
</script>

<style>
  .page { padding-top: 40px; }
  .narrow { max-width: 520px; }
  .calc { background: var(--bg-soft); padding: 28px; border-radius: 12px; margin-top: 20px; }
  .result { text-align: center; margin-top: 22px; padding-top: 20px; border-top: 1px solid var(--border); }
  .result div:first-child { color: var(--muted); font-size: 14px; }
  .amount { font-size: 40px; font-weight: 900; color: var(--primary); }
</style>
