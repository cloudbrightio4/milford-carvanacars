---
import Layout from '../layouts/Layout.astro';
import { API_BASE } from '../lib/api';
---
<Layout title="Sold Vehicles" description="Previously sold vehicles.">
  <div class="container page">
    <h1>Sold vehicles</h1>
    <div id="grid" class="grid"></div>
    <p id="empty" class="muted" style="display:none">No sold vehicles at this time.</p>
  </div>
</Layout>

<script define:vars={{ API_BASE }}>
  const grid = document.getElementById('grid');
  const money = (n) => '$' + Math.round(n).toLocaleString('en-US');
  (async () => {
    const r = await fetch(`${API_BASE}/api/cars?offer_type=Sold`);
    const d = await r.json();
    const cars = d.results || [];
    if (!cars.length) { document.getElementById('empty').style.display = 'block'; return; }
    grid.innerHTML = cars.map((c) => `<a class="card" href="/listing/${c.slug}/">
      <div class="thumb"><img src="${c.featured_image || ''}" alt="${c.title}" loading="lazy" /><span class="ptag">${money(c.price)}</span></div>
      <div class="body"><h3>${c.title}</h3></div></a>`).join('');
  })();
</script>

<style>
  .page { padding-top: 40px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 20px; }
  .card { display: block; background: #fff; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
  .card:hover { text-decoration: none; box-shadow: 0 8px 24px rgba(0,0,0,.08); }
  .thumb { position: relative; aspect-ratio: 4/3; background: var(--bg-soft); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .ptag { position: absolute; bottom: 10px; right: 10px; background: rgba(21,21,21,.82); color: #fff; padding: 4px 10px; border-radius: 6px; font-weight: 800; font-size: 14px; }
  .body { padding: 14px 16px; }
  .body h3 { font-size: 16px; margin: 0; color: var(--dark); }
</style>
