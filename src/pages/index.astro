---
import Layout from '../layouts/Layout.astro';
import CarCard from '../components/CarCard.astro';
import seed from '../../data/seed-cars.json';
const cars = [...seed].sort((a, b) => (b.year || 0) - (a.year || 0)).slice(0, 8);
---
<Layout description="Milford Carvana Cars — classic and collector cars. Browse our hand-picked inventory of vintage American and European vehicles.">
  <section class="hero">
    <div class="container hero-inner">
      <span class="hero-kicker">Classic &amp; collector cars</span>
      <h1>Drive a legend home.</h1>
      <p>Hand-picked vintage American and European vehicles, fully inspected and ready for the road.</p>
      <div class="hero-actions">
        <a href="/search/" class="btn">Browse inventory</a>
        <a href="/contact-us/" class="btn ghost">Contact us</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">Featured vehicles</h2>
        <a href="/search/" class="see-all">View all →</a>
      </div>
      <div class="grid">
        {cars.map((c) => <CarCard car={c} />)}
      </div>
    </div>
  </section>

  <section class="section cta-band">
    <div class="container">
      <h2>Looking for something specific?</h2>
      <p>Tell us what you're after and we'll help you find it.</p>
      <a href="/contact-us/" class="btn">Get in touch</a>
    </div>
  </section>
</Layout>

<style>
  .hero { background: linear-gradient(135deg, #151515 0%, #2a150a 100%); color: #fff; }
  .hero-inner { padding: 80px 20px 90px; }
  .hero-kicker { color: var(--primary); font-weight: 800; text-transform: uppercase; letter-spacing: .12em; font-size: 13px; }
  .hero h1 { color: #fff; font-size: 52px; font-weight: 900; margin: 10px 0 16px; }
  .hero p { font-size: 19px; color: #e5e7eb; max-width: 560px; }
  .hero-actions { display: flex; gap: 14px; margin-top: 28px; flex-wrap: wrap; }
  .section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
  .see-all { font-weight: 700; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 22px; }
  .cta-band { background: var(--primary-light); text-align: center; }
  .cta-band h2 { margin-bottom: 8px; }
  .cta-band p { margin: 0 0 22px; color: var(--muted); }
  @media (max-width: 640px) { .hero h1 { font-size: 38px; } }
</style>
